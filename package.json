{
  "name": "pond-steward",
  "private": true,
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build -w @pond-steward/engine",
    "test": "npm run test -w @pond-steward/engine",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "balance": "npm run build && npm run balance -w @pond-steward/balance"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
